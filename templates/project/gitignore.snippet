# agentic-thesis-writing:start
# LaTeX build artefacts (regenerated on every compile)
{{THESIS_DIR}}/**/*.aux
{{THESIS_DIR}}/**/*.bbl
{{THESIS_DIR}}/**/*.bcf
{{THESIS_DIR}}/**/*.blg
{{THESIS_DIR}}/**/*.fdb_latexmk
{{THESIS_DIR}}/**/*.fls
{{THESIS_DIR}}/**/*.lof
{{THESIS_DIR}}/**/*.log
{{THESIS_DIR}}/**/*.lot
{{THESIS_DIR}}/**/*.out
{{THESIS_DIR}}/**/*.run.xml
{{THESIS_DIR}}/**/*.synctex.gz
{{THESIS_DIR}}/**/*.toc
{{THESIS_DIR}}/**/*.xdv
# Keep the built PDF out of git unless you decide otherwise
{{THESIS_DIR}}/report.pdf
# Installer conflict files
*.atw.new
# Local agent state
.claude/settings.local.json
.claude/worktrees/
# Papers and notes dropped in for the agents (keep the README only)
agent_reference/*
!agent_reference/README.md
# agentic-thesis-writing:end
